[flake8]

per-file-ignores =
    v.osm.import.tag.py: E203,E265,E266,E402,E711,E712,E713,E722,E731,E741,F401,F632,F821,F841,E111,E711,F632,W391,E111,E121,E125,E127,E128,E202,E211,E221,E225,E226,E231,E251,E261,E271,E272,E302,E303,E305,E501,W293,W391,W503,W504,E121,E221,E251

max-line-length = 80
exclude =
    .git,
    __pycache__,
    .env,
    .venv,
    env,
    venv,
    ENV,
    env.bak,
    venv.bak,
    ctypes,
    pydispatch,
