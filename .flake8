[flake8]

# E501 line too long (83 > 79 characters)
# F821 undefined name '_'
# F824 `xyz` is unused: name is never assigned in scope

exclude = .git
max-line-length = 88
per-file-ignores =
    # ./v.osm.import.tag.py: E203,E265,E266,E402,E711,E712,E713,E722,E731,E741,F401,F632,F821,F841,E111,E711,F632,W391,E111,E121,E125,E127,E128,E202,E211,E221,E225,E226,E231,E251,E261,E271,E272,E302,E303,E305,E501,W293,W391,W503,W504,E121,E221,E251, F824
    ./v.osm.import.tag.py: E501, F821, F824
